# API base URL for the backend
REACT_APP_API_URL=http://localhost:5000/api

# Rapyd publishable/client key (safe to expose in frontend — never commit real keys)
# Replaces the former REACT_APP_STRIPE_PUBLISHABLE_KEY.
# Get this from: https://dashboard.rapyd.net/ → Developers → Client Keys
# Format: a long alphanumeric string (not a JWT)
REACT_APP_RAPYD_PUBLISHABLE_KEY=your_rapyd_client_key_here

# NOTE: REACT_APP_STRIPE_PUBLISHABLE_KEY has been removed.
# Stripe is no longer used in this application.
