# API base URL for the backend
REACT_APP_API_URL=http://localhost:5000/api

# Payments use Airwallex Hosted Checkout (redirect flow). The backend holds the
# Airwallex API key / client ID and creates Hosted Payment Pages via the
# Airwallex API; the frontend only redirects the user to the returned
# redirect_url. No Airwallex key is needed in this React app.
